<?xml version='1.0' encoding='utf-8'?>
<resources>
    <string name="app_name">Re-MIND-eЯ</string>
    <string name="title_activity_main">Re-MIND-eЯ</string>
    <string name="package_name">com.reminderhealth.app</string>
    <string name="custom_url_scheme">com.reminderhealth.app</string>

    <!-- Full-screen dose alarm (M2 step 4). Copy follows the Pillo teardown's
         zero-blame framing: the decline action is honest ("Skip"), never
         guilt-worded, and no wording anywhere counts how many times someone has
         been asked. -->
    <string name="alarm_taken">Taken</string>
    <string name="alarm_skip">Skip</string>
    <string name="alarm_snooze">Snooze 10 min</string>
    <string name="alarm_eyebrow_prefix">Dose due</string>
    <string name="alarm_photo_description">Photo from your care circle</string>

    <!-- Coalesced ring (2026-08-14). Doses at the same instant are one handful,
         presented together and answered one at a time. -->
    <string name="alarm_title">Time to take %1$s</string>
    <string name="alarm_title_retry">Still time to take %1$s</string>
    <string name="alarm_group_title">Time for %1$d medicines</string>
    <string name="alarm_missed_title">Missed: take %1$s</string>
    <string name="alarm_missed_group_title">Missed: %1$d medicines</string>
    <string name="alarm_tap_to_open">Tap to open Re-MIND-eЯ</string>
    <string name="alarm_tap_to_record">Tap to record this dose</string>

    <!-- Shown under the time when several doses share one instant. Plain count,
         no urgency: it answers "how many am I looking at", nothing more. -->
    <string name="alarm_group_count">%1$d medicines</string>
    <!-- Elderly density: one question at a time, so the count becomes progress. -->
    <string name="alarm_group_progress">%1$d of %2$d</string>

    <!-- Answering a handful. "Taken all" is spelled out rather than reusing
         "Taken", because on a group it is a claim about four medicines and the
         person tapping it should be able to see that. -->
    <string name="alarm_taken_all">Taken all</string>
    <string name="alarm_open">Open</string>

    <!-- Per-dose confirmation, left on screen so the handful can be checked off
         and seen. The mark means "recorded" in all three cases. -->
    <string name="alarm_recorded_taken">✓ Taken</string>
    <string name="alarm_recorded_skipped">✓ Skipped</string>
    <string name="alarm_recorded">✓ Recorded</string>
    <string name="alarm_all_done">All done</string>

    <!-- The quiet states in a focused list. "Not answered" is a fact, not a
         verdict: the dose's ring window passed, nothing was decided, and tapping
         the row starts it again. Never "You missed", never a count. -->
    <string name="alarm_waiting">Waiting</string>
    <string name="alarm_not_answered">Not answered</string>
    <!-- Read out for the tappable rows; the visual affordance is the card. -->
    <string name="alarm_tap_to_answer">Tap to answer this one now</string>

    <!-- ================================================================
         WATER NUDGE (2026-08-15). Moved out of WaterNudge.kt so it can be
         translated at all.

         The tone is load-bearing and must survive translation: this is the
         QUIET TIER. No urgency, no streak, no guilt, and "Taken" is the only
         action because skipping water is not an event worth recording.
         ================================================================ -->
    <string name="water_title">Time for a glass of water</string>
    <!-- "%1$d of %2$d today" — Western numerals, like every count in this app. -->
    <string name="water_progress">%1$d of %2$d today</string>
    <string name="water_untracked">Tap Taken to count it</string>
    <string name="water_taken">Taken</string>

    <!-- ================================================================
         NOTIFICATION CHANNELS.

         These appear in ANDROID'S OWN settings, not in our UI, and Android
         caches the name from when the channel was created — so a language
         change does not rename an existing channel until it is recreated.
         Translated anyway: a fresh install in Telugu should not list its
         channels in English, and the stale-name case is cosmetic and
         self-corrects on reinstall.
         ================================================================ -->
    <string name="channel_dose_name">Medication reminders</string>
    <string name="channel_dose_description">Alerts when it is time to take a medication</string>
    <string name="channel_missed_name">Missed doses</string>
    <string name="channel_water_name">Water reminders</string>
    <string name="channel_water_description">Gentle reminders to drink water. Never full-screen.</string>
</resources>
