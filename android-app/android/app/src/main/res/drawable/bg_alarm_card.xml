<?xml version="1.0" encoding="utf-8"?>
<!-- One dose inside a handful. White card on the paper ground, matching the
     card surfaces the web uses for the same job. Surface only — never a tint
     that competes with the primary action. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FFFFFF" />
    <corners android:radius="20dp" />
    <stroke android:width="1dp" android:color="#E4DFE7" />
</shape>
