<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen dose alarm. Hierarchy is taken from the Pillo teardown §4 S30
  breakdown (docs/design/pillo-teardown.md), which CLAUDE.md names as the
  reference blueprint for this screen:

    identity block (centred)   eyebrow time -> med name (largest) -> dose
    action band (pinned)       Taken   (primary, big, ON TOP)
                               Skip    (grey, full size, honest decline)
                               Snooze  (smallest, tinted, deferral)

  "Unambiguous" is the whole point: a half-asleep user must not have to read.

  THE COALESCED RING (2026-08-14). Doses at the SAME instant are one handful, so
  this screen holds a LIST rather than a single dose. The list is one row per
  dose, each answered on its own; the layout for a row lives in
  alarm_dose_solo.xml (one dose, or elderly) and alarm_dose_grouped.xml (several).
  Both carry the same ids, so AlarmActivity binds them with one function and the
  two presentations cannot drift into two behaviours.

  Snooze stays down here, once, because it is the one action that means the same
  thing for the whole handful: not now, ask again in ten minutes.

  Touch targets are all >= 56dp, above the 44dp floor the teardown's
  accessibility notes call out, and generous for elderly users.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alarm_bg">

    <!-- FAMILY VOICE ALARMS hook (CLAUDE.md "Post-M2 features"): the caregiver's
         photo, shown full-screen behind the content. Both this and the scrim stay
         GONE unless AlarmActivity verifies a readable local file — so the default
         alarm is byte-identical to having no photo feature at all, and a
         missing/deleted file degrades silently instead of showing a broken frame.
         The mascot fallback art drops in here as this ImageView's default src. -->
    <ImageView
        android:id="@+id/alarm_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:contentDescription="@string/alarm_photo_description" />

    <!-- Legibility scrim. A caregiver's photo is arbitrary — it can be bright,
         busy, or light-on-light — so text over it needs a guaranteed floor of
         contrast rather than hoping the photo cooperates. -->
    <View
        android:id="@+id/alarm_photo_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8C000000"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="20dp">

        <!-- When and how many. Never a count of how often you have been asked. -->
        <TextView
            android:id="@+id/alarm_eyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/alarm_ink_muted"
            android:letterSpacing="0.04"
            android:gravity="center"
            android:text="@string/alarm_eyebrow_prefix" />

        <TextView
            android:id="@+id/alarm_group_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="15sp"
            android:textColor="@color/alarm_ink_muted"
            android:gravity="center"
            android:visibility="gone" />

        <!-- The doses. Scrolls because a handful can be four or more, and a dose
             pushed off the bottom of the screen is a dose nobody answers. -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/alarm_dose_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_vertical" />
        </ScrollView>

        <!-- Shown once every dose in the handful has been answered, just long
             enough to be seen before the screen closes itself. -->
        <TextView
            android:id="@+id/alarm_all_done"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/verdict_taken"
            android:gravity="center"
            android:text="@string/alarm_all_done"
            android:visibility="gone" />

        <!-- Deferral, smallest, tinted — and one for the whole handful: "not now"
             is the same answer whether it covers one medicine or four. -->
        <Button
            android:id="@+id/alarm_snooze"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/alarm_snooze"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:textColor="@color/alarm_ink"
            android:background="@drawable/bg_alarm_tertiary" />
    </LinearLayout>
</FrameLayout>
