<?xml version="1.0" encoding="utf-8"?>
<!--
  ONE dose inside a handful. Four of these stack under a single "Time for 4
  medicines" heading, each answered on its own.

  Same ids as alarm_dose_solo.xml — see that file. The name stays the largest
  thing in the row, because "which medicine is this?" is still the question the
  row has to answer before any button means anything; it is just no longer the
  largest thing on the SCREEN, since there are several of them.

  Taken keeps more width than Skip. In a list the two would otherwise read as
  equal choices, and they are not: one is what the person is here to do.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="10dp"
    android:padding="14dp"
    android:background="@drawable/bg_alarm_card">

    <TextView
        android:id="@+id/dose_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/alarm_ink"
        android:lineSpacingMultiplier="1.05" />

    <TextView
        android:id="@+id/dose_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="12dp"
        android:textSize="16sp"
        android:textColor="@color/alarm_ink_muted" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/dose_taken"
            android:layout_width="0dp"
            android:layout_weight="1.7"
            android:layout_height="56dp"
            android:text="@string/alarm_taken"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="@color/alarm_on_primary"
            android:background="@drawable/bg_alarm_primary" />

        <Button
            android:id="@+id/dose_skip"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="56dp"
            android:layout_marginStart="10dp"
            android:text="@string/alarm_skip"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="@color/alarm_ink"
            android:background="@drawable/bg_alarm_secondary" />
    </LinearLayout>
</LinearLayout>
