<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- M2 alarm core. exported=false: only this app's own AlarmManager
             alarms trigger it, never another app. -->
        <receiver
            android:name=".schedule.AlarmReceiver"
            android:exported="false" />

        <!-- Full-screen dose alarm, launched by the notification's full-screen
             intent. showOnLockScreen + turnScreenOn are the manifest half of
             what AlarmActivity also sets in code (the code path covers <27).
             excludeFromRecents/noHistory: an answered alarm should not linger
             in the recents list to be reopened out of context.
             singleInstance: a second alarm for the same dose reuses this window
             rather than stacking duplicates. -->
        <activity
            android:name=".schedule.AlarmActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/AlarmTheme" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- M2 alarm core. This list is deliberately minimal and is capped by
         CLAUDE.md's hard rule: exact-alarm + full-screen-intent +
         notifications + boot only. No SYSTEM_ALERT_WINDOW, no location, no
         storage, nothing else.

         The two exact-alarm permissions are a version split, not a duplicate:
         SCHEDULE_EXACT_ALARM covers Android 12 (API 31-32) where it is granted
         at install; USE_EXACT_ALARM covers 13+ (API 33+) where it is
         auto-granted to alarm-class apps — medication reminders are an
         explicitly approved use case for it, which is why the app can rely on
         exact alarms rather than asking the user to grant them by hand. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the dose notification take over the screen (AlarmActivity) instead
         of needing SYSTEM_ALERT_WINDOW. Auto-granted on 14+ to alarm-class apps;
         DoseNotifications logs a warning and degrades to a heads-up notification
         if it is ever denied. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Vibration for the alarm. Normal permission, granted at install. -->
    <uses-permission android:name="android.permission.VIBRATE" />
</manifest>
