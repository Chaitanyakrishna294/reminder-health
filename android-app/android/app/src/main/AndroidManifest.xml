<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- M2 alarm core. exported=false: only this app's own AlarmManager
             alarms trigger it, never another app. -->
        <receiver
            android:name=".schedule.AlarmReceiver"
            android:exported="false" />

        <!-- Taken / Skip tapped on the notification itself, for when the phone is
             unlocked and Android shows the alarm as a heads-up notification
             instead of a full-screen takeover. exported=false: only this app's own
             notification buttons may record a dose — an exported receiver would
             let any app on the device mark someone's medication as taken. -->
        <receiver
            android:name=".schedule.DoseActionReceiver"
            android:exported="false" />

        <!-- Re-registers alarms after a reboot or an app update, both of which
             clear every AlarmManager alarm. exported=true is REQUIRED here: these
             are system broadcasts, and a non-exported receiver never receives
             them. directBootAware so LOCKED_BOOT_COMPLETED lands before the user
             has unlocked. -->
        <receiver
            android:name=".schedule.BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Full-screen dose alarm, launched by the notification's full-screen
             intent. showOnLockScreen + turnScreenOn are the manifest half of
             what AlarmActivity also sets in code (the code path covers <27).
             taskAffinity="" + singleInstance: the alarm lives in its OWN task,
             completely separate from MainActivity's, so answering an alarm can
             never disturb the app's own back stack.
             excludeFromRecents: an answered alarm should not linger in recents
             to be reopened out of context.

             No android:noHistory — removed 2026-08-11. It finishes the activity
             whenever it merely loses focus, which for an alarm is wrong twice
             over: a momentary system window (an incoming call banner, a vivo
             overlay) would silently kill a dose alarm mid-ring, and the activity
             already finishes itself explicitly on every action and on the 60s
             timeout, so it was buying nothing. -->
        <activity
            android:name=".schedule.AlarmActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/AlarmTheme" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- M2 alarm core. This list is deliberately minimal and is capped by
         CLAUDE.md's hard rule: exact-alarm + full-screen-intent +
         notifications + boot only. No SYSTEM_ALERT_WINDOW, no location, no
         storage, nothing else.

         The two exact-alarm permissions are a version split, not a duplicate:
         SCHEDULE_EXACT_ALARM covers Android 12 (API 31-32) where it is granted
         at install; USE_EXACT_ALARM covers 13+ (API 33+) where it is
         auto-granted to alarm-class apps — medication reminders are an
         explicitly approved use case for it, which is why the app can rely on
         exact alarms rather than asking the user to grant them by hand. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the dose notification take over the screen (AlarmActivity) instead
         of needing SYSTEM_ALERT_WINDOW. Auto-granted on 14+ to alarm-class apps;
         DoseNotifications logs a warning and degrades to a heads-up notification
         if it is ever denied. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Vibration for the alarm. Normal permission, granted at install. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Lets BootReceiver re-register alarms after a reboot; Android drops every
         AlarmManager alarm on shutdown, so without this a phone that rebooted
         overnight would wake with no reminders and no sign anything was wrong. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>
