# Dependency directories
node_modules/
**/node_modules/

# Next.js Build Outputs & Caches
.next/
**/.next/
out/
**/out/
*.tsbuildinfo
next-env.d.ts

# Environment configuration files (Do NOT commit secrets)
.env
.env.local
.env.production
.env.development
.env.test
.env.local
.env.*.local
.env.production.local
**/.env
**/.env.local
**/.env.production
**/.env.*

# AI Agents / Scratch files / Local logs
.agents/
# `.claude/*` and not `.claude/`, deliberately: git never evaluates a negation for
# something inside an ignored DIRECTORY, so `.claude/` + `!.claude/skills/` silently
# does nothing. Ignoring the children individually is what makes the re-include work.
.claude/*
# Project skills ARE part of the project — they encode the copy constitution and the
# accessibility floor, so they must travel with the repo and show up in a diff.
# A rule that lives on one machine is not a rule.
!.claude/skills/
scratch/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local datasets (source CSVs already imported into Supabase — do not commit)
dataset/

# Never commit an app-signing keystore — it is the root of trust for Play Store updates.
# Keep it backed up out-of-band (not in git). (The abandoned Bubblewrap TWA attempt that used
# to live at android-twa/ — superseded by the Capacitor conversion, see CLAUDE.md — was deleted
# 2026-08-10, keystore included; it was never published, so there was no obligation to it.)
*.keystore
*.jks
# The signing PASSWORDS, which are as fatal to leak as the keystore itself — a
# committed password plus a keystore recovered from anywhere means anyone can
# publish an update to this app. The keystore file is deliberately stored OUTSIDE
# the repository entirely; this file only points at it.
keystore.properties
**/keystore.properties

# Test coverage
coverage/
**/coverage/
.nyc_output/

